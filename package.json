{
  "name": "nomod-cli",
  "version": "1.0.0",
  "description": "Find and delete unused node_modules to free disk space: by hand with a checklist, or by an AI agent in one call with a short JSON summary that saves tool calls and tokens.",
  "keywords": [
    "node_modules",
    "cleanup",
    "disk-space",
    "delete",
    "cli",
    "npkill",
    "developer-tools",
    "ai-agents",
    "llms-txt",
    "claude-code",
    "json",
    "zero-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piyook/nomod-cli.git"
  },
  "homepage": "https://github.com/piyook/nomod-cli#readme",
  "bugs": {
    "url": "https://github.com/piyook/nomod-cli/issues"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/nomod.test.js",
    "test:coverage": "c8 node --test test/nomod.test.js",
    "fallow": "fallow audit --base origin/main",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "validate-branch-name": "node scripts/validate-branch-name.mjs",
    "prepare": "husky",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "node --check nomod.js && node nomod.js --version"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "bin": {
    "nomod": "nomod.js"
  },
  "files": [
    "nomod.js",
    "llms.txt",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "c8": "^12.0.0",
    "fallow": "3.39.0",
    "husky": "^9.1.7"
  }
}
