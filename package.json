{
  "name": "nomod-cli",
  "version": "1.0.0",
  "description": "Find node_modules folders, see how much disk space they take, and delete the ones you don't need.",
  "keywords": [
    "node_modules",
    "cleanup",
    "disk-space",
    "delete",
    "cli",
    "npkill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piyook/nomod-cli.git"
  },
  "homepage": "https://github.com/piyook/nomod-cli#readme",
  "bugs": {
    "url": "https://github.com/piyook/nomod-cli/issues"
  },
  "type": "module",
  "scripts": {
    "release": "node scripts/release.mjs",
    "prepublishOnly": "node --check nomod.js && node nomod.js --version"
  },
  "bin": {
    "nomod": "nomod.js"
  },
  "files": [
    "nomod.js",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
